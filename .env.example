# Copia este archivo como .env (no se sube a git) y rellena lo que uses.

# YouTube Data API v3 (gratis): https://console.cloud.google.com/apis/credentials
# Crea un proyecto, activa "YouTube Data API v3" y crea una "Clave de API".
YOUTUBE_API_KEY=

# WhatsApp de JARVIS (whatsapp/README.md). Se vincula con QR; aquí no van claves.
# Solo si usas un número aparte para JARVIS: tu celular con código de país, sin + ni espacios.
# Con tu propio número no hace falta: JARVIS obedece en tu chat contigo mismo.
WHATSAPP_PERMITIDOS=
# 0 = no avisar en tu chat cada vez que alguien te escribe (por defecto avisa y propone respuestas).
WHATSAPP_AVISAR=
# 1 = también anota los mensajes de grupos en la bóveda (por defecto solo chats individuales).
WHATSAPP_GUARDAR_GRUPOS=
# Números cuyos chats NO se anotan nunca (separados por coma).
WHATSAPP_NO_GUARDAR=
