# Copia este archivo como .env (no se sube a git) y rellena lo que uses.

# YouTube Data API v3 (gratis): https://console.cloud.google.com/apis/credentials
# Crea un proyecto, activa "YouTube Data API v3" y crea una "Clave de API".
YOUTUBE_API_KEY=

# WhatsApp de JARVIS con Kapso (whatsapp/README.md). whatsapp/instalar.sh genera el secreto.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
# Tu celular con código de país, sin + ni espacios. Solo estos números pueden darle órdenes.
WHATSAPP_PERMITIDOS=
