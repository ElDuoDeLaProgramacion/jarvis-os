# Copia este archivo como .env (no se sube a git) y rellena lo que uses.

# YouTube Data API v3 (gratis): https://console.cloud.google.com/apis/credentials
# Crea un proyecto, activa "YouTube Data API v3" y crea una "Clave de API".
YOUTUBE_API_KEY=

# WhatsApp de JARVIS (whatsapp/README.md). Se vincula con QR; aquí no van claves.
# Solo si usas un número aparte para JARVIS: tu celular con código de país, sin + ni espacios.
# Con tu propio número no hace falta: JARVIS obedece en tu chat contigo mismo.
WHATSAPP_PERMITIDOS=
# 0 = no avisar en tu chat cada vez que alguien te escribe (por defecto avisa y propone respuestas).
WHATSAPP_AVISAR=
# 1 = también anota los mensajes de grupos en la bóveda (por defecto solo chats individuales).
WHATSAPP_GUARDAR_GRUPOS=
# Números cuyos chats NO se anotan nunca (separados por coma).
WHATSAPP_NO_GUARDAR=

# Notas de voz de WhatsApp: modelo de faster-whisper (base = rápido, small = por defecto, medium = más fino).
WHATSAPP_MODELO_AUDIO=

# Spotify Web API (opcional, Premium): para que las listas suenen solas. Ver voz/README.md.
SPOTIFY_CLIENT_ID=

# Servidor y app del celular (servidor/README.md). servidor/instalar.sh la crea sola en el servidor.
# En el PC copia aquí la misma clave del servidor para que la voz y el HUD le pasen los pedidos.
JARVIS_API_TOKEN=
# Solo en el PC: la dirección del servidor (la misma de la app, sin /app/). Vacío = todo se hace en el PC.
JARVIS_SERVIDOR=

# Pruebas de seguridad (habilidad seguridad): sistemas tuyos que JARVIS puede revisar además de este equipo,
# separados por comas (por ejemplo la IP pública del servidor y su nombre de Tailscale). Solo lo editas tú.
JARVIS_OBJETIVOS_SEGURIDAD=

# IAs externas a Claude (habilidad segunda-opinion, scripts/ia_externa.py). Pon las que tengas.
# Gemini (Google, con capa gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter: una sola clave para GPT, Llama, DeepSeek, Mistral, Grok... Sin saldo usa sus modelos gratis (:free, con límite diario);
# con saldo prepago, cualquier modelo: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Opcional: modelo fijo (si no, Gemini usa su flash más nuevo y OpenRouter uno gratis). Con saldo: OPENROUTER_MODELO=openrouter/auto
GEMINI_MODELO=
OPENROUTER_MODELO=
